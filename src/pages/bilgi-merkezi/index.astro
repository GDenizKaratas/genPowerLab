---
const target = '/bilgi-merkezi/teknik-rehberler';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Teknik Rehberler'e yönlendiriliyor...</title>
  </head>
  <body>
    <script is:inline>
      window.location.replace('/bilgi-merkezi/teknik-rehberler');
    </script>
    <p>
      Teknik Rehberler'e yönlendiriliyorsunuz.
      <a href={target}>Devam etmek için tıklayın.</a>
    </p>
  </body>
</html>
