---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SupportCTA from '../../components/ui/SupportCTA.astro';
import { Building2, CheckCircle } from 'lucide-astro';
import projectThumb1 from '../../assets/blog-placeholder-1.jpg';
import projectThumb2 from '../../assets/blog-placeholder-2.jpg';
import projectThumb3 from '../../assets/blog-placeholder-3.jpg';
import projectThumb4 from '../../assets/blog-placeholder-4.jpg';
import projectThumb5 from '../../assets/blog-placeholder-5.jpg';
import projectThumb6 from '../../assets/blog-placeholder-about.jpg';

const breadcrumbItems = [{ label: 'Projects & References' }];

const categories = [
  { id: 'all', label: 'All' },
  { id: 'industrial', label: 'Industrial' },
  { id: 'commercial', label: 'Commercial' },
  { id: 'residential', label: 'Residential' },
  { id: 'critical', label: 'Critical' },
];

const categoryLabels = Object.fromEntries(categories.map((category) => [category.id, category.label]));

const projects = [
  {
    title: 'Textile Factory Power System',
    category: 'industrial',
    location: 'Bursa',
    capacity: '500 kVA',
    description: 'Standby power system design for uninterrupted production.',
    features: ['Automatic transfer', 'Parallel operation', 'Remote monitoring'],
    year: '2024',
    image: projectThumb1.src,
  },
  {
    title: 'Shopping Mall Standby Power',
    category: 'commercial',
    location: 'Istanbul',
    capacity: '1000 kVA',
    description: 'Integrated standby power solution for a large-scale retail facility.',
    features: ['Multiple generators', 'Smart load management', 'Low-noise operation'],
    year: '2024',
    image: projectThumb2.src,
  },
  {
    title: 'Villa Complex Energy Solution',
    category: 'residential',
    location: 'Bodrum',
    capacity: '150 kVA',
    description: 'Centralized backup power for a 12-villa residential compound.',
    features: ['Central control', 'Noise isolation', 'Automatic testing'],
    year: '2023',
    image: projectThumb3.src,
  },
  {
    title: 'Hospital Emergency Power System',
    category: 'critical',
    location: 'Ankara',
    capacity: '800 kVA',
    description: 'Reliable power continuity for critical healthcare services.',
    features: ['Rapid start', 'Dual redundancy', '24/7 monitoring'],
    year: '2024',
    image: projectThumb4.src,
  },
  {
    title: 'Logistics Center Infrastructure',
    category: 'industrial',
    location: 'Kocaeli',
    capacity: '350 kVA',
    description: 'Reliable energy support for cold-chain operations.',
    features: ['Cooling integration', 'Fuel optimization', 'Remote management'],
    year: '2023',
    image: projectThumb5.src,
  },
  {
    title: 'Boutique Hotel Generator System',
    category: 'commercial',
    location: 'Cappadocia',
    capacity: '100 kVA',
    description: 'Quiet compact solution designed for a historic setting.',
    features: ['Ultra-quiet', 'Compact design', 'Visual fit'],
    year: '2024',
    image: projectThumb6.src,
  },
];

const stats = [
  { value: '150+', label: 'Projects' },
  { value: '50+', label: 'Clients' },
  { value: '10+', label: 'Years of Experience' },
];
---

<BaseLayout
  title="Projects & References - GenPowerLab"
  description="Generator and energy projects delivered across different sectors."
>
  <div class="container mx-auto px-4 lg:px-1 py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">
          Projects & <span class="text-blue-600">References</span>
        </h1>
        <p class="text-gray-600">
          Completed generator and energy projects from different sectors.
        </p>
      </div>
      <div class="flex gap-6">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-600">{stat.value}</div>
            <div class="text-xs text-gray-500">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap gap-2 mb-6" id="category-filter">
      {categories.map((cat) => (
        <button
          data-category={cat.id}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${
            cat.id === 'all'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-100 text-gray-700 hover:bg-blue-50 hover:text-blue-700'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10" id="projects-grid">
      {projects.map((project) => (
        <article class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-blue-200 transition-all" data-category={project.category}>
          <div class="relative h-28 sm:h-32 overflow-hidden bg-gray-100">
            <img src={project.image} alt={`${project.title} project visual`} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/35 via-transparent to-transparent"></div>
            <span class="absolute left-3 bottom-3 px-2.5 py-1 bg-white/90 text-gray-800 rounded-lg text-xs font-semibold shadow-sm backdrop-blur-sm">
              {project.location}
            </span>
          </div>
          <div class="bg-gradient-to-br from-gray-100 to-gray-50 p-4 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-600">
              <Building2 class="w-4 h-4" />
              <span>{categoryLabels[project.category]}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-medium">{project.capacity}</span>
              <span class="px-2 py-0.5 bg-gray-200 text-gray-600 rounded text-xs">{project.year}</span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{project.title}</h3>
            <p class="text-gray-600 text-sm mb-4">{project.description}</p>
            <div class="space-y-1.5">
              {project.features.map((feature) => (
                <div class="flex items-center text-xs text-gray-500">
                  <CheckCircle class="w-3.5 h-3.5 text-green-500 mr-2 flex-shrink-0" />
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
  <SupportCTA
    title="Need guidance?"
    description="Share your generator or energy requirement and we’ll point you to the right resource or expert."
    buttonLabel="Contact us"
    link="/en/iletisim"
    secondaryLabel="info@genpowerlab.com"
    badgeLabel="Support"
    note="Generator & energy platform"
  />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#category-filter button');
    const projectCards = document.querySelectorAll('#projects-grid article');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');

        filterButtons.forEach((btn) => {
          btn.classList.remove('bg-blue-600', 'text-white');
          btn.classList.add('bg-gray-100', 'text-gray-700');
        });
        button.classList.remove('bg-gray-100', 'text-gray-700');
        button.classList.add('bg-blue-600', 'text-white');

        projectCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          (card as HTMLElement).style.display = category === 'all' || cardCategory === category ? 'block' : 'none';
        });
      });
    });
  });
</script>
