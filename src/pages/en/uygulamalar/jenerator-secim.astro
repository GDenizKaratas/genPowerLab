---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { GeneratorSelectionApp } from '../../../components/generator-selection/GeneratorSelectionApp';
import { Calculator } from 'lucide-astro';
---

<BaseLayout
  title="Generator Selection Assistant | GenPowerLab"
  description="Calculate a practical generator capacity for your load list, operating profile and project preferences."
>
  <section class="bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3">
    <div class="container mx-auto px-3 sm:px-4">
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-2">
          <Calculator class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 text-blue-200" />
          <div class="truncate text-base sm:text-[22px] font-semibold text-white/90">
            Generator Selection Assistant
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-3 sm:py-6 bg-gray-50 min-h-[calc(100vh-200px)]">
    <div class="container mx-auto px-3 sm:px-4">
      <GeneratorSelectionApp client:load />
    </div>
  </section>
</BaseLayout>
