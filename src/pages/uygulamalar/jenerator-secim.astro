---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GeneratorSelectionApp } from '../../components/generator-selection/GeneratorSelectionApp';
import { Calculator } from 'lucide-astro';
---

<BaseLayout
  title="Jeneratör Seçim Asistanı | GenPower Lab"
  description="İhtiyacınıza uygun jeneratör kombinasyonunu hesaplayın. Cihazlarınızı ekleyin, kullanım senaryonuzu belirleyin ve size özel motor-alternatör önerisi alın."
>
  <!-- Compact Hero Section -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3">
    <div class="container mx-auto px-3 sm:px-4">
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-2">
          <Calculator class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 text-blue-200" />
          <div class="truncate text-base sm:text-[22px] font-semibold text-white/90">
            Jeneratör Seçim Asistanı
          </div>
        </div>
        <p class="text-white-200 text-xs md:text-sm hidden sm:block">
          
        </p>
      </div>
    </div>
  </section>

  <!-- Main App Section -->
  <section class="py-3 sm:py-6 bg-gray-50 min-h-[calc(100vh-200px)]">
    <div class="container mx-auto px-3 sm:px-4">
      <GeneratorSelectionApp client:load />
    </div>
  </section>
</BaseLayout>
